# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
MODEL_DEPLOYMENT_NAME=gpt-4o
ANALYSIS_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# Content Understanding (optional - defaults to AZURE_OPENAI_ENDPOINT)
CONTENT_UNDERSTANDING_ENDPOINT=https://your-content-understanding-resource.openai.azure.com/

# Azure Client ID (optional - for user-assigned managed identity)
# Leave empty for system-assigned or local development with Azure CLI auth
AZURE_CLIENT_ID=
